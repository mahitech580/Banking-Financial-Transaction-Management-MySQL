# Copy this file to .env and set local/test MySQL credentials.
# Use either MYSQL_URL or the individual MYSQL_* variables below.
# Example: mysql://user:password@host:3306/banking_financial_management
MYSQL_URL=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=banking_financial_management
# Set true only when your MySQL provider requires TLS.
MYSQL_SSL=false
MYSQL_CONNECTION_LIMIT=10
# Transfers stay disabled unless explicitly enabled for synthetic-data testing.
ENABLE_DEMO_TRANSFERS=false
PORT=10000
# Local development only; Render sets NODE_ENV=production.
NODE_ENV=development
